# Nothing derived from source material, and nothing transient, belongs here.
*.pdf
*.txt.gz
cookies*.txt

# Obsidian: the vault CONFIG is committed so the repo opens the same way for everyone
# (and so markdown links stay the default -- design/adr/0011). Per-machine state is not.
.obsidian/workspace*
.obsidian/cache
.obsidian/graph.json
.obsidian/hotkeys.json
# --- kord: GitHub Issue Tracking substrate ---
.kord/
.github/ISSUE_TEMPLATE/kord-epic.md
.github/ISSUE_TEMPLATE/kord-feature.md
# --- end kord: GitHub Issue Tracking substrate ---
# --- kord: GitHub Spec Kit substrate ---
# specs/ is deliberately NOT ignored: a feature spec is a design artefact and belongs in the
# history, the same posture kord itself takes (its ADR 0008). The tooling around it is vendored
# and regenerable, so that is ignored.
.specify/
.claude/skills/speckit-*/
# --- end kord: GitHub Spec Kit substrate ---

# Python bytecode from running the verification scripts in specs/.
__pycache__/
*.py[cod]
